@using kms.Models.KeyCustody
@using kms.Models.ViewModels
@model KeyDetailViewModel
@{
    ViewData["Title"] = Model.KeyName;
    string Short(string name) => name.Replace("key_", "").Trim();
    var n = Model.Now;
    var (stateClass, stateText) = n.State switch
    {
        KeyTileState.OnBoard => ("kc-tile--board", "On the board — not moved this day"),
        KeyTileState.Returned => ("kc-tile--returned", $"Returned at {n.Since:HH:mm}" + (n.Holder != null ? $" by {n.Holder}" : "")),
        KeyTileState.Out => ("kc-tile--out", $"Out with {n.Holder} since {n.Since:HH:mm}"),
        KeyTileState.Overdue => ("kc-tile--overdue", $"OVERDUE — out with {n.Holder} since {n.Since:HH:mm}"),
        KeyTileState.NotReturned => ("kc-tile--overdue", $"Never scanned back — last taken by {n.Holder} at {n.Since:HH:mm}"),
        _ => ("kc-tile--problem", n.LastResult == KcResult.NoFace
                ? $"Taken at {n.Since:HH:mm} — no face scanned"
                : $"Taken at {n.Since:HH:mm} by {n.Holder} — NOT authorized")
    };
    int maxMoves = Math.Max(1, Model.History.Max(h => h.Moves));
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <div class="text-muted small mb-1"><a asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">Key Board</a> › Key</div>
        <h1 class="h2 fw-bold mb-1"><i class="bi bi-key"></i> @Short(Model.KeyName)</h1>
        <p class="text-muted mb-0">@(Model.Location ?? "") · device no. @Model.KeyEnroll</p>
    </div>
    <form method="get" class="d-flex gap-2 align-items-end">
        <input type="date" name="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" onchange="this.form.submit()" aria-label="Date" />
    </form>
</div>

<div class="kc-tile @stateClass kc-key-state mb-3">
    <div class="d-flex align-items-center gap-3">
        @if (n.HolderEnroll != null && n.State != KeyTileState.OnBoard)
        {
            <partial name="_Avatar" model="@((n.HolderEnroll, n.Holder, "md"))" />
        }
        <div>
            <div class="small text-muted">@Model.Date.ToString("dd MMM yyyy")</div>
            <div class="fs-5 fw-bold">@stateText</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm kc-static mb-3">
            <div class="card-header bg-white"><strong><i class="bi bi-clock-history"></i> Scans on @Model.Date.ToString("dd MMM yyyy")</strong></div>
            <ul class="list-group list-group-flush">
                @if (Model.Day.Count == 0)
                {
                    <li class="list-group-item text-muted">No scans for this key on this day.</li>
                }
                @foreach (var k in Model.Day)
                {
                    <a asp-action="Movement" asp-route-id="@k.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <partial name="_Avatar" model="@((k.FaceEnroll, k.FaceName ?? "No face", "sm"))" />
                            <div>
                                <partial name="_Direction" model="k.Direction" /> <span class="ms-1">@k.ScanTime.ToString("HH:mm:ss")</span>
                                <div class="small text-muted">@(k.FaceName ?? "no face scanned")</div>
                            </div>
                        </div>
                        <partial name="_Result" model="k.Result" />
                    </a>
                }
            </ul>
        </div>

        <div class="card border-0 shadow-sm kc-static mb-3">
            <div class="card-header bg-white"><strong><i class="bi bi-calendar3"></i> Last 14 days</strong>
                <span class="small text-muted ms-2">click a day</span></div>
            <div class="card-body">
                <div class="kc-history">
                    @foreach (var h in Model.History.OrderBy(h => h.Day))
                    {
                        <a class="kc-history__day" asp-action="Key" asp-route-id="@Model.KeyEnroll" asp-route-date="@h.Day.ToString("yyyy-MM-dd")"
                           title="@h.Day.ToString("ddd dd MMM"): @h.Moves scan(s), @h.Problems problem(s)">
                            <span class="kc-history__bar" style="height:@(8 + 72 * h.Moves / maxMoves)px">
                                @if (h.Problems > 0) { <span class="kc-history__bad" style="height:@(100 * h.Problems / Math.Max(1, h.Moves))%"></span> }
                            </span>
                            <span class="kc-history__lbl @(h.Day == Model.Date ? "fw-bold" : "")">@h.Day.ToString("dd")</span>
                        </a>
                    }
                </div>
                <div class="small text-muted mt-2"><span class="kc-dot kc-tile--out"></span>scans <span class="kc-dot kc-tile--problem ms-2"></span>problems</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm kc-static mb-3">
            <div class="card-header bg-white d-flex justify-content-between">
                <strong><i class="bi bi-person-check"></i> Authorized (@Model.Authorized.Count)</strong>
                <a class="small" asp-controller="Authorizations" asp-action="Manage" asp-route-keyEnroll="@Model.KeyEnroll">Change</a>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.Authorized.Count == 0)
                {
                    <li class="list-group-item text-muted">Nobody is authorized for this key.</li>
                }
                @foreach (var p in Model.Authorized)
                {
                    <li class="list-group-item d-flex align-items-center gap-2">
                        <partial name="_Avatar" model="@(((int?)p.Enroll, p.Name, "sm"))" />
                        <span>@p.Name</span><span class="small text-muted ms-auto">@p.Department</span>
                    </li>
                }
            </ul>
        </div>

        <div class="card border-0 shadow-sm kc-static">
            <div class="card-header bg-white d-flex justify-content-between">
                <strong><i class="bi bi-shield-exclamation text-danger"></i> Recent incidents</strong>
                <a class="small" asp-action="Incidents" asp-route-q="@Model.KeyName" asp-route-from="@Model.Date.AddDays(-90).ToString("yyyy-MM-dd")" asp-route-to="@Model.Date.ToString("yyyy-MM-dd")">All</a>
            </div>
            <div class="list-group list-group-flush">
                @if (Model.RecentIncidents.Count == 0)
                {
                    <div class="list-group-item text-success">No incidents for this key.</div>
                }
                @foreach (var i in Model.RecentIncidents)
                {
                    <a class="list-group-item list-group-item-action py-2" asp-action="Incident" asp-route-id="@i.Id">
                        <div class="d-flex justify-content-between">
                            <span class="kc-tag kc-type--@i.Type text-white">@KcIncidentType.Label(i.Type)</span>
                            <small class="text-muted">@i.IncidentDate.ToString("dd MMM") @i.OccurredAt?.ToString("HH:mm")</small>
                        </div>
                        @if (i.PersonName != null) { <div class="small mt-1">@i.PersonName</div> }
                    </a>
                }
            </div>
        </div>
    </div>
</div>
