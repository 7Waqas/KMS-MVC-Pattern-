@using kms.Models.KeyCustody
@using kms.Models.ViewModels
@model IncidentListViewModel
@{
    ViewData["Title"] = "Security Incidents";
    var types = new[] { KcIncidentType.NotAuthorized, KcIncidentType.NoFace, KcIncidentType.TakenWithoutScan,
                        KcIncidentType.ReturnNotScanned, KcIncidentType.SilentKey };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="display-6 fw-bold text-danger mb-1"><i class="bi bi-shield-exclamation"></i> Security Incidents</h1>
        <p class="text-muted mb-0">Every bypass and violation found in the scans, with the people who were at the board.</p>
    </div>
    <button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
</div>

<div class="card border-0 shadow-sm mb-3 kc-static">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold mb-1">From</label>
                <input type="date" name="from" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold mb-1">To</label>
                <input type="date" name="to" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold mb-1">Type</label>
                <select name="type" class="form-select">
                    <option value="">All types</option>
                    @foreach (var t in types)
                    {
                        <option value="@t" selected="@(Model.Type == t)">@KcIncidentType.Label(t)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold mb-1">Severity</label>
                <select name="maxSeverity" class="form-select">
                    <option value="1" selected="@(Model.MaxSeverity == 1)">High only</option>
                    <option value="2" selected="@(Model.MaxSeverity == 2)">High + medium</option>
                    <option value="3" selected="@(Model.MaxSeverity == 3)">All (incl. silent keys)</option>
                </select>
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small fw-bold mb-1">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="@KcStatus.Open" selected="@(Model.Status == KcStatus.Open)">Open</option>
                    <option value="@KcStatus.Confirmed" selected="@(Model.Status == KcStatus.Confirmed)">Confirmed</option>
                    <option value="@KcStatus.Dismissed" selected="@(Model.Status == KcStatus.Dismissed)">Dismissed</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold mb-1">Key or person</label>
                <input type="text" name="q" class="form-control" value="@Model.Search" placeholder="e.g. D-23" />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <button class="btn btn-success"><i class="bi bi-funnel"></i></button>
            </div>
        </form>
    </div>
</div>

<p class="text-muted small">
    @Model.TotalMatching incident(s) from @Model.From.ToString("dd MMM yyyy") to @Model.To.ToString("dd MMM yyyy")
    @if (Model.TotalMatching > Model.Items.Count) { <span>— showing the latest @Model.Items.Count. Narrow the dates to see more.</span> }
</p>

<div class="card border-0 shadow-sm kc-static">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date / time</th>
                    <th>Type</th>
                    <th>Key</th>
                    <th>Responsible / top suspect</th>
                    <th>What happened</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-success py-5"><i class="bi bi-shield-check display-6 d-block"></i>No incidents for this filter.</td></tr>
                }
                @foreach (var i in Model.Items)
                {
                    <tr class="kc-row" onclick="location.href='@Url.Action("Incident", new { id = i.Id })'">
                        <td class="text-nowrap">@i.IncidentDate.ToString("dd MMM yyyy")<br /><small class="text-muted">@i.OccurredAt?.ToString("HH:mm:ss")</small></td>
                        <td><span class="badge kc-type kc-type--@i.Type">@KcIncidentType.Label(i.Type)</span></td>
                        <td class="fw-bold text-nowrap">@i.KeyName</td>
                        <td>@(i.PersonName ?? "—")</td>
                        <td class="small">@i.Summary</td>
                        <td>
                            <span class="badge @(i.Status == KcStatus.Confirmed ? "bg-danger" : i.Status == KcStatus.Dismissed ? "bg-secondary" : "bg-warning text-dark")">@i.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
