@model kms.Models.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Evening Keys NOT Returned";
    var notReturnedRows = ViewBag.NotReturnedRows as List<Dictionary<string, object>> ?? new();
    var fromDate = (DateOnly)ViewBag.FromDate;
    var toDate = (DateOnly)ViewBag.ToDate;
    var isSingleDay = (bool)ViewBag.IsSingleDay;
    var isRange = !isSingleDay;
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold">
            <i class="bi bi-sunset text-info"></i>
            Evening Keys NOT Returned
        </h1>
        <p class="text-muted">Keys that were not scanned back in during the evening</p>
    </div>
    <div class="col-md-4 text-end d-print-none">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- Print-only heading (shown only when printing) -->
<div class="row mb-2 d-none d-print-block">
    <div class="col-12">
        <h5 class="mb-0">
            Keys NOT Returned @(isRange ? $"({fromDate:dd MMM yyyy} – {toDate:dd MMM yyyy})" : $"({fromDate:dd MMM yyyy})")
        </h5>
        <p class="text-muted" style="font-size:12px;">Printed on @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p>
    </div>
</div>

<!-- Date Range Filter -->
<div class="row mb-4">
    <div class="col-md-5 d-print-none">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="EveningKeysNotReturned" method="get" id="dateFilterForm">
                    <label class="form-label fw-bold mb-2">
                        <i class="bi bi-calendar3"></i> Date Range
                    </label>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">From</label>
                            <input type="date" name="fromDate" id="fromDateInput" class="form-control form-control-sm"
                                   value="@fromDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">To</label>
                            <input type="date" name="toDate" id="toDateInput" class="form-control form-control-sm"
                                   value="@toDate.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-info btn-sm flex-fill">
                            <i class="bi bi-funnel"></i> Apply
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="applyMonthlyRange()">
                            <i class="bi bi-calendar-month"></i> This Month
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm flex-fill" onclick="window.print()" title="Print this report">
                            <i class="bi bi-printer-fill"></i> Print
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm bg-danger bg-opacity-10">
            <div class="card-body">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                    Total Keys NOT Returned
                    @(isRange ? $"({fromDate:dd MMM yyyy} – {toDate:dd MMM yyyy})" : $"({fromDate:dd MMM yyyy})"):
                    <span class="badge bg-danger">@Model.TotalRecords</span>
                </h5>
            </div>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        @if (isRange)
                        {
                            <th><i class="bi bi-calendar3"></i> Date</th>
                        }
                        <th><i class="bi bi-key"></i> Key Name</th>
                        <th><i class="bi bi-geo-alt"></i> Location</th>
                        <th><i class="bi bi-exclamation-triangle"></i> Status</th>
                        <th><i class="bi bi-person"></i> Taken By (Holding)</th>
                        <th><i class="bi bi-people"></i> Authorized Persons</th>
                    </tr>
                </thead>
                <tbody>
                    @if (notReturnedRows.Any())
                    {
                        @foreach (var row in notReturnedRows)
                        {
                            <tr class="table-danger">
                                @if (isRange)
                                {
                                    <td>@(((DateOnly)row["Date"]).ToString("dd MMM yyyy"))</td>
                                }
                                <td>
                                    <i class="bi bi-key-fill text-danger me-2"></i>
                                    <strong>@row["KeyName"]</strong>
                                </td>
                                <td>@row["KeyLocation"]</td>
                                <td>
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-circle"></i> NOT RETURNED
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        <i class="bi bi-person"></i>
                                        @row["ReturnedBy"]
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        <i class="bi bi-person-check"></i>
                                        @row["AuthorizedPersons"]
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isRange ? 6 : 5)" class="text-center py-5">
                                <i class="bi bi-check-circle display-1 text-success"></i>
                                <p class="mt-3 text-success fw-bold">
                                    ✅ All keys have been returned during this period!
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.onload = function() {
            const params = new URLSearchParams(window.location.search);
            if (params.get('print') === 'true') {
                window.print();
            }
        }

        function applyMonthlyRange() {
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            const pad = n => String(n).padStart(2, '0');
            const toStr = (dt) => `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
            document.getElementById('fromDateInput').value = toStr(firstDay);
            document.getElementById('toDateInput').value = toStr(now);
            document.getElementById('dateFilterForm').submit();
        }
    </script>
}
